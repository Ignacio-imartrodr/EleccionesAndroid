<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VotarActivity">

    <LinearLayout
        android:layout_width="409dp"
        android:layout_height="729dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <TextView
            android:id="@+id/lblCandidatos"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/StringLblCandidatos"
            android:textSize="25sp" />

        <Spinner
            android:id="@+id/spCandidatos"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:textSize="25sp" />

        <!--<Button
            android:id="@+id/btnVotar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/StringVotar"
            android:textSize="25sp" /> -->

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/frmBtnLimitado"
            android:name="com.example.elecciones.BotonLimitado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:layout="@layout/fragment_boton_limitado" />

        <!--<TextView
            android:id="@+id/lblVotosRestantes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/StringLblVotosRestantes" />-->
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>